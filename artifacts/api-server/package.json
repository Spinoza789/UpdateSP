{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:coa": "COA_DB_TESTS=1 vitest run src/lib/coa-rules.test.ts src/lib/group-buy-coa.integration.test.ts src/routes/group-buy-coa.test.ts",
    "build:sites": "BASE_PATH=/ PORT=21504 pnpm --filter @workspace/peps-anonymous run build && BASE_PATH=/ PORT=21505 pnpm --filter @workspace/testmedaddy run build && pnpm run build",
    "dev": "NODE_ENV=development node --env-file=../../.env --import tsx ./src/index.ts",
    "build": "tsx ./build.ts",
    "build:compile": "tsx ./build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:tmd": "TMD_DB_TESTS=1 vitest run src/lib/testmedaddy-core.test.ts src/routes/testmedaddy/core.integration.test.ts",
    "test:bundle": "API_BUNDLE_SMOKE_TESTS=1 vitest run src/lib/production-bundle.test.ts src/lib/site-frontends.test.ts",
    "migrate:db-backups": "tsx scripts/migrate-db-backups-to-google-drive.ts",
    "restore:db-backup": "tsx scripts/restore-db-backup-from-google-drive.ts",
    "backfill:shared-organiser-payments": "tsx scripts/backfill-shared-organiser-order-payments.ts",
    "test:e2e:payment-audit": "node scripts/payment-audit-e2e.mjs",
    "test:e2e:vendor-portal": "VENDOR_PORTAL_BROWSER_TESTS=1 vitest run src/routes/__tests__/vendor-portal.browser.test.ts"
  },
  "dependencies": {
    "@google/genai": "workspace:*",
    "@noble/hashes": "1.8.0",
    "@replit/connectors-sdk": "^0.4.2",
    "@replit/object-storage": "^1.0.0",
    "@solana/web3.js": "1.98.4",
    "@types/multer": "^2.1.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/payout-assets": "workspace:*",
    "@workspace/shipping": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bech32": "2.0.0",
    "bs58": "6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5",
    "express-rate-limit": "^8.3.1",
    "file-type": "^22.1.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "sharp": "^0.35.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "tsx": "catalog:",
    "vitest": "^4.1.9"
  }
}
